# Database credentials must stay in the local .env or environment variables.
CRAWLER_DB_HOST=127.0.0.1
CRAWLER_DB_PORT=3306
CRAWLER_DB_USER=
CRAWLER_DB_PASSWORD=
CRAWLER_DB_NAME=dsfa_policy

CRAWLER_KMS_BASE_URL=http://10.1.3.144:20002
CRAWLER_KMS_PATH=/kms/api/etl/dg/crawlerToBase
CRAWLER_KMS_UPDATE_PATH=/kms/openapi/knowledge/document/update
CRAWLER_KMS_AUTH_CHECK_PATH=/kms/openapi/knowledge/stat/overview
CRAWLER_KMS_TOKEN_PATH=/platform/api/v2/auth/getToken
CRAWLER_KMS_APPLICATION_KEY=
CRAWLER_KMS_APPLICATION_SECRET=
CRAWLER_KMS_ACCESS_TOKEN=
CRAWLER_KMS_AUTHORIZATION=
CRAWLER_KMS_COOKIE=
CRAWLER_POLICY_BASE_URL=https://aies.dreamdt.cn
CRAWLER_POLICY_CLASSIFY_PATH=/policy/api/policy-classification/classify
CRAWLER_ENABLE_CONTENT_UPDATE=false

CRAWLER_BIND_HOST=127.0.0.1
CRAWLER_BIND_PORT=8000
# 非本机监听时必须设置；生产环境请通过本地 .env 或环境变量保存真实凭据。
CRAWLER_ADMIN_USER=
CRAWLER_ADMIN_PASSWORD=
CRAWLER_REQUEST_TIMEOUT_SECONDS=60
CRAWLER_KMS_TIMEOUT_SECONDS=300
# 连续超过该分钟数未写入进度、且服务内没有活动线程的批次会自动标记中断。
CRAWLER_RUN_STALE_MINUTES=30
CRAWLER_ITEM_DELAY_SECONDS=0.2
CRAWLER_MAX_ITEMS_PER_TASK=0
CRAWLER_SCHEDULE_HOUR=1
CRAWLER_SCHEDULE_MINUTE=0
CRAWLER_LOG_LEVEL=INFO
